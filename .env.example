# Best topic filtering + daily/random quotes
API_NINJAS_KEY=

# Optional paid/random access. Public QOD still works without a key.
THEYSAIDSO_API_KEY=

# Optional. Free endpoints are attempted when this is empty.
ZENQUOTES_KEY=

# Optional. Required for FavQs random/tag search; QOTD is public.
FAVQS_TOKEN=

# Recommended for semantic/literary quote translation.
# The translator uses gpt-5.6-luna by default for low-cost multilingual translation.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna

# Optional machine-translation fallback.
DEEPL_API_KEY=

# Optional and recommended by MyMemory for higher-volume identification.
MYMEMORY_EMAIL=
